# CuttleX 自托管环境变量示例（Docker Compose 使用）
# 复制为 .env 后填写
#
# 管理面板登录密码（必填，请用足够长的随机串）
CUTTLE_TOKEN=replace-with-a-long-random-secret

# 独立密钥，至少 32 字节，用于加密可恢复订阅 token（必填）
CUTTLE_LINK_KEY=replace-with-an-independent-long-random-secret

# 可选：订阅链接的固定公开域名；留空时使用当前管理请求的域名
# CUTTLE_PUBLIC_ORIGIN=https://cuttle.example.com
